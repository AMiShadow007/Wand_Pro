<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!--#region Language Metadata -->
    <s:String x:Key="language_display_name">বাংলা (বাংলাদেশ)</s:String>
    <!--#endregion -->

    <!--#region MainWindow -->
    <s:String x:Key="mw_folder_path">ফোল্ডারের পথ</s:String>
    <s:String x:Key="mw_folder_not_found">ফোল্ডার পাওয়া যায়নি</s:String>
    <s:String x:Key="mw_patch">উন্নত করুন</s:String>
    <s:String x:Key="mw_restore">পুনরুদ্ধার</s:String>
    <s:String x:Key="mw_source_code">সোর্স কোড</s:String>
    <s:String x:Key="mw_made_by">❤️ দিয়ে তৈরি করেছেন k1tbyte</s:String>
    <s:String x:Key="mw_star_hint">এটা সাহায্যকারী মনে হলে স্টার দিন ;)</s:String>
    <s:String x:Key="mw_copy_logs">লগ ক্লিপবোর্ডে কপি করুন</s:String>
    <s:String x:Key="mw_export_logs">ফাইলে লগ এক্সপোর্ট করুন</s:String>
    <s:String x:Key="mw_update_badge">নতুন ভার্সন উপলব্ধ</s:String>
    <!--#endregion -->

    <!--#region Settings -->
    <s:String x:Key="settings_title">সেটিংস</s:String>
    <s:String x:Key="settings_language">ভাষা</s:String>
    <s:String x:Key="settings_check_updates">শুরুতে আপডেট চেক করুন</s:String>
    <s:String x:Key="settings_check_prereleases">প্রি-রিলিজের বিজ্ঞপ্তিও দেখান</s:String>
    <s:String x:Key="settings_save">সেভ</s:String>
    <!--#endregion -->

    <!--#region UpdatePopup -->
    <s:String x:Key="up_popup_title">আপডেট উপলব্ধ</s:String>
    <s:String x:Key="up_warning">WandEnhancer নিজে নিজে আপডেট হয় না। আপনার fork-এ নতুন ভার্সন তৈরি করুন, অথবা রিলিজ পেজ খুলুন।</s:String>
    <s:String x:Key="up_current_version">বর্তমান:</s:String>
    <s:String x:Key="up_latest_version">সর্বশেষ:</s:String>
    <s:String x:Key="up_release_notes">রিলিজ নোট</s:String>
    <s:String x:Key="up_show_more">সম্পূর্ণ চেঞ্জলগ দেখুন</s:String>
    <s:String x:Key="up_show_less">রিলিজ নোট দেখুন</s:String>
    <s:String x:Key="up_loading_changelog">লোড হচ্ছে...</s:String>
    <s:String x:Key="up_changelog_failed">সম্পূর্ণ চেঞ্জলগ লোড করা যায়নি।</s:String>
    <s:String x:Key="up_release_notes_unavailable">কোনো রিলিজ নোট প্রকাশিত হয়নি।</s:String>
    <s:String x:Key="up_open_release">রিলিজ পেজ খুলুন</s:String>
    <!--#endregion -->

    <!--#region EnhanceVectorsPopup -->
    <s:String x:Key="pv_activate_pro">WeMod Pro সক্রিয় করুন</s:String>
    <s:String x:Key="pv_devtools">F12-এ DevTools</s:String>
    <s:String x:Key="pv_disable_updates">আপডেট বন্ধ করুন</s:String>
    <s:String x:Key="pv_remote_web_panel_preview">রিমোট অ্যাক্সেস সক্ষম করুন (বিটা)</s:String>
    <s:String x:Key="pv_custom_scripts">কাস্টম স্ক্রিপ্ট</s:String>
    <s:String x:Key="pv_add_js_scripts">.js যোগ করুন</s:String>
    <s:String x:Key="pv_custom_scripts_hint">নির্বাচিত .js ফাইলগুলো Wand-এ প্যাক করা হয় এবং রেন্ডারারে লোড হয়।</s:String>
    <s:String x:Key="pv_no_custom_scripts">কোনো স্ক্রিপ্ট নির্বাচন করা হয়নি</s:String>
    <s:String x:Key="pv_start">শুরু</s:String>
    <s:String x:Key="pv_auto_apply">আপডেটের পরে অটো-প্রয়োগ</s:String>
    <s:String x:Key="pv_popup_title">আমরা কী উন্নত করব?</s:String>
    <s:String x:Key="pv_patch_method">প্যাচ পদ্ধতি</s:String>
    <s:String x:Key="pv_strategy_static">স্ট্যাটিক (সুপারিশকৃত)</s:String>
    <s:String x:Key="pv_strategy_supervised">সুপারভাইজড (রানটাইম)</s:String>
    <s:String x:Key="pv_strategy_hint">স্ট্যাটিক পদ্ধতিতে Wand ডিস্কে পরিবর্তন করা হয়, যা তার ডিজিটাল স্বাক্ষর নষ্ট করে। সুপারভাইজড প্যাচ প্রতিটি লঞ্চের সময় মেমরিতে প্রয়োগ করা হয় — এটি অ্যান্টিভাইরাসকে সতর্ক করতে পারে এবং সব সেটআপে কাজ নাও করতে পারে।</s:String>
    <!--#endregion -->

    <!--#region Runtime log -->
    <s:String x:Key="log_install_found">WeMod ডিরেক্টরি {0} ({1}) এ পাওয়া গেছে</s:String>
    <s:String x:Key="log_already_patched">WeMod ইতিমধ্যে প্যাচ করা হয়েছে। আপনি আবার প্যাচ করতে চাইলে আগে ব্যাকআপ পুনরুদ্ধার করুন।</s:String>
    <s:String x:Key="log_ready">প্যাচের জন্য প্রস্তুত।</s:String>
    <s:String x:Key="log_install_not_found">WeMod ডিরেক্টরি পাওয়া যায়নি।</s:String>
    <s:String x:Key="log_no_directory">এটা করা যাবে না। আগে ডিরেক্টরি নির্বাচন করুন।</s:String>
    <s:String x:Key="log_invalid_directory">নির্বাচিত ফোল্ডার {0} একটি বৈধ WeMod ডিরেক্টরি নয়।</s:String>
    <s:String x:Key="log_restore_failed">ব্যাকআপ পুনরুদ্ধার করতে ব্যর্থ: {0}</s:String>
    <s:String x:Key="log_patch_failed">প্যাচ করতে ব্যর্থ: {0}</s:String>
    <s:String x:Key="log_copied">লগ ক্লিপবোর্ডে কপি করা হয়েছে।</s:String>
    <s:String x:Key="log_copy_failed">লগ কপি করতে ব্যর্থ: {0}</s:String>
    <s:String x:Key="log_exported">লগ {0} ফাইলে এক্সপোর্ট করা হয়েছে।</s:String>
    <s:String x:Key="log_export_failed">লগ এক্সপোর্ট করতে ব্যর্থ: {0}</s:String>
    <s:String x:Key="log_open_link_failed">{0} ব্রাউজারে খুলতে পারা যায়নি।</s:String>
    <s:String x:Key="dialog_pick_install">WeMod ডিরেক্টরি নির্বাচন করুন</s:String>
    <!--#endregion -->

</ResourceDictionary>
